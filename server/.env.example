# Free vision models via OpenRouter (https://openrouter.ai/settings/keys). Preferred.
# OPENROUTER_KEY works as an alternative name.
OPENROUTER_API_KEY=
# Optional: use one specific OpenRouter model instead of the default list
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Paid alternative: OpenAI (used only when OPENROUTER_API_KEY is empty)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# With no key at all the app runs in DEMO mode and returns sample meals.

# Port for the backend API (Vite dev server proxies /api here)
PORT=3001
